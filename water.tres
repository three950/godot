[resource]
code = "shader_type canvas_item;
render_mode blend_mix;

uniform vec4 WaterColor : source_color;
uniform vec4 wet_colorwhite : source_color = vec4(1.000000, 1.000000, 1.000000, 1.000000);
uniform float wetting_degree = 0.10000000149012;
uniform sampler2D tex_frg_10;
uniform sampler2D tex_frg_3;
uniform float circle1_radius = 0.30000001192093;



void fragment() {
// Input:8
	vec4 n_out8p0 = COLOR;


// ColorParameter:2
	vec4 n_out2p0 = WaterColor;


// ColorParameter:6
	vec4 n_out6p0 = wet_colorwhite;


// FloatParameter:5
	float n_out5p0 = wetting_degree;


// Texture2D:10
	vec4 n_out10p0 = texture(tex_frg_10, UV);
	float n_out10p1 = n_out10p0.r;
	float n_out10p2 = n_out10p0.g;


// VectorCompose:11
	vec2 n_out11p0 = vec2(n_out10p1, n_out10p2);


// Texture2D:3
	vec4 n_out3p0 = texture(tex_frg_3, n_out11p0);


// Step:4
	float n_out4p0 = step(n_out5p0, n_out3p0.x);


// Mix:7
	vec4 n_out7p0 = mix(n_out2p0, n_out6p0, vec4(n_out4p0));
	float n_out7p4 = n_out7p0.a;


// FloatParameter:14
	float n_out14p0 = circle1_radius;


// Mix:9
	vec4 n_out9p0 = mix(n_out8p0, n_out7p0, vec4(n_out14p0));
	float n_out9p4 = n_out9p0.a;


// Output:0
	COLOR.rgb = vec3(n_out9p0.xyz);
	COLOR.a = n_out9p4;


}
"
